rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function myPhone() { return request.auth != null && request.auth.token.phone_number != null ? request.auth.token.phone_number.replace('+965','') : ''; }
    function isOwner() {
      return request.auth != null && (
        resource.data.phone == myPhone() ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // admin may save own push tokens only
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']);
      allow create, delete: if false;
    }

    // Accounting + bot settings: admins only (the bot uses the Admin SDK and bypasses rules)
    match /transactions/{id} { allow read, write: if isAdmin(); }
    match /settings/{id}     { allow read, write: if isAdmin(); }
    match /botState/{id}     { allow read, write: if false; }
    // Pay catalog: public read (prices are public), admin write
    match /payItems/{id}     { allow read: if true; allow write: if isAdmin(); }
    // Payments: created/updated only by Cloud Functions; parent can fetch their own order by id; admin lists
    match /payments/{id}     { allow get: if true; allow list: if isAdmin(); allow write: if false; }

    // Parent portal: one doc per phone, readable by anyone who knows the phone (get only — no listing).
    // Parents may only append pause requests / push tokens; everything else is written by admins / the bot.
    match /portal/{phone} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pauseRequests', 'fcmTokens']);
    }

    match /subscriptions/{subId} {
      allow read, write: if isAdmin();
      allow create: if request.resource.data.status == 'pending_review'
                    && request.resource.data.termsAccepted == true
                    && request.resource.data.phone is string;

    }
  }
}
